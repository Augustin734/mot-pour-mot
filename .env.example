# Copier ce fichier en .env et changer le mot de passe.

POSTGRES_DB=motpourmot
POSTGRES_USER=motpourmot
POSTGRES_PASSWORD=changez-moi
POSTGRES_PORT=5432

# Adresse utilisée par le pipeline, Alembic et les tests (depuis l'hôte).
DATABASE_URL=postgresql+psycopg://motpourmot:changez-moi@localhost:5432/motpourmot
